generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum UserRole {
  NONE
  STORE_OWNER
  SUPPLIER
  BOTH
}

enum BusinessType {
  RETAILER
  WHOLESALER
  DISTRIBUTOR
  MANUFACTURER
  IMPORTER
  EXPORTER
  TRADER
  PROCESSOR
  AGRO_PROCESSOR
  APPAREL_FACTORY
}

enum BusinessSize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum Category {
  GROCERIES
  FMCG
  FRESH_PRODUCE
  AGRO_PRODUCTS
  FISHERY_SEAFOOD
  MEAT_POULTRY
  DAIRY
  ELECTRONICS
  MOBILE_ACCESSORIES
  CLOTHING
  TEXTILES_APPAREL
  FOOTWEAR
  BEAUTY_PERSONAL_CARE
  HOME_APPLIANCE
  FURNITURE
  HARDWARE
  CONSTRUCTION_MATERIALS
  AUTO_PARTS
  PHARMACY
  STATIONERY
  OFFICE_SUPPLIES
  PACKAGING
  CHEMICALS
  PLASTICS
  RESTAURANT_SUPPLY
  HOSPITALITY_SUPPLY
  OTHER
}

enum PricingType {
  BUDGET
  VALUE
  MID_RANGE
  PREMIUM
}

enum NegotiationPreference {
  FLEXIBLE
  FIXED
  NO_NEGOTIATION
}

enum DeliveryTime {
  SAME_DAY
  NEXT_DAY
  TWO_THREE_DAYS
  WITHIN_WEEK
  FLEXIBLE
}

enum DistancePreference {
  NEIGHBORHOOD
  LOCAL
  CITY
  REGIONAL
  NATIONWIDE
  INTERNATIONAL
}

enum ServiceArea {
  LOCAL
  CITY
  REGIONAL
  NATIONWIDE
  INTERNATIONAL
}

enum DeliveryMethod {
  SELF
  COURIER
  BOTH
  PICKUP
  FREIGHT
}

enum BuyingPriority {
  CHEAP
  FAST
  QUALITY
  RELIABILITY
  CONSISTENCY
}

enum SupplierTag {
  FAST_DELIVERY
  BULK_DISCOUNT
  PREMIUM_QUALITY
  LOW_PRICE
  FACTORY_DIRECT
  CASH_ON_DELIVERY
  VAT_INVOICE
  HALAL_CERTIFIED
  BSTI_CERTIFIED
  EXPORT_READY
  COLD_CHAIN
  SAMPLE_AVAILABLE
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum StockUnit {
  PCS
  KG
  GRAM
  LITER
  ML
  METER
  BOX
  PACK
  DOZEN
  BOTTLE
  CAN
  ROLL
}

// =========================
// USER MODEL
// =========================

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  onboarded Boolean  @default(false)

  // -------- BASIC INFO --------
  name         String
  phone        String? @unique
  email        String? @unique
  username     String? @unique
  password     String?
  profileImage String?
  businessName String?

  role         UserRole     @default(NONE)
  businessType BusinessType?
  businessSize BusinessSize?

  // -------- LOCATION --------
  district  String?
  area      String?
  latitude  Float?
  longitude Float?

  // -------- CATEGORY --------
  primaryCategory Category?
  subCategories   String[] @default([])

  // =========================
  // SELLER-SPECIFIC FIELDS
  // =========================
  monthlyPurchaseRange  String?
  pricingPreference     PricingType?
  negotiationPreference NegotiationPreference?
  maxDeliveryTime       DeliveryTime?
  preferredDistance     DistancePreference?
  buyingPriority        BuyingPriority?
  restockFrequency      String?

  // =========================
  // SUPPLIER-SPECIFIC FIELDS
  // =========================
  serviceArea           ServiceArea?
  serviceRadiusKm       Int?
  deliveryMethod        DeliveryMethod?
  deliveryTimeRange     DeliveryTime?
  pricingType           PricingType?
  bulkDiscountAvailable Boolean?
  orderCapacity         BusinessSize?
  supplierTags          SupplierTag[] @default([])

  // =========================
  // TRUST / QUALITY SIGNALS
  // =========================
  isVerified        Boolean @default(false)
  yearsInBusiness   Int?
  avgRating         Float   @default(0)
  totalTransactions Int     @default(0)

  // =========================
  // OPERATIONAL SIGNALS
  // =========================
  businessRegistrationId String?
  paymentTerms           String?
  minOrderValue          Float?
  maxOrderValue          Float?
  isActive               Boolean   @default(true)
  lastActiveAt           DateTime?

  // =========================
  // RELATIONS
  // =========================
  inventory      Product[] @relation("ProductOwner")
  suppliedProducts Product[] @relation("ProductSupplier")
  bundles        Bundle[]  @relation("BundleOwner")
  sales          Sale[]    @relation("SaleOwner")

  @@index([role, district, primaryCategory])
  @@index([businessType, businessSize])
}

// =========================
// PRODUCT (INVENTORY + EXPIRY)
// =========================

model Product {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], name: "ProductOwner")

  supplierId  String?
  supplier    User?    @relation(fields: [supplierId], references: [id], name: "ProductSupplier")

  name        String
  description String?
  barcode     String?
  sku         String?
  category    Category?

  costPrice   Float    @default(0)
  sellingPrice Float   @default(0)

  quantity    Float    @default(0)
  unit        StockUnit @default(PCS)
  minStock    Float?    // alert threshold

  expiryDate  DateTime?
  batchNumber String?

  isActive    Boolean  @default(true)

  saleItems   SaleItem[]
  bundleItems BundleItem[]

  @@index([ownerId, category])
  @@index([barcode])
  @@index([expiryDate])
}

// =========================
// BUNDLES
// =========================

model Bundle {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], name: "BundleOwner")

  name        String
  description String?
  discount    Float    @default(0)
  isActive    Boolean  @default(true)

  items       BundleItem[]

  @@index([ownerId, isActive])
}

model BundleItem {
  id        String  @id @default(uuid())

  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Float   @default(1)

  @@index([bundleId])
  @@index([productId])
}

// =========================
// SALES & INVOICES
// =========================

model Sale {
  id            String        @id @default(uuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ownerId       String
  owner         User          @relation(fields: [ownerId], references: [id], name: "SaleOwner")

  invoiceNumber String        @unique
  customerName  String?
  customerPhone String?

  totalAmount   Float
  discount      Float         @default(0)
  finalAmount   Float

  paymentStatus PaymentStatus @default(UNPAID)
  paidAmount    Float         @default(0)
  dueAmount     Float

  notes         String?

  items         SaleItem[]

  @@index([ownerId, createdAt])
  @@index([paymentStatus])
}

model SaleItem {
  id         String  @id @default(uuid())

  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId  String
  product    Product @relation(fields: [productId], references: [id])

  quantity   Float
  unitPrice  Float
  totalPrice Float

  @@index([saleId])
  @@index([productId])
}
